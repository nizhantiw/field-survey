# FieldSurvey environment variables
# Copy this file to .env.local for local development. Never commit real secrets.
# Only VITE_* variables are visible to the browser. Everything else stays on the
# machine that runs tests or server scripts.

# --- Required for the browser app ---
# Supabase project URL, e.g. https://YOUR_PROJECT.supabase.co
# or http://127.0.0.1:54321 when using the local Supabase CLI.
VITE_SUPABASE_URL=

# Supabase anon (public) key. This is the publishable key, not the service role.
# Safe to ship in the browser only because Row Level Security must be enabled.
VITE_SUPABASE_ANON_KEY=

# --- Optional online basemap ---
# Leave blank to use the coordinates-only fallback.
# Do not point this at a tile server whose license forbids your usage.
# FieldSurvey does not bulk-download OpenStreetMap tiles.
# Example: https://tiles.example.com/{z}/{x}/{y}.png
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=

# --- Local browser harness (tests only) ---
# Set to 1 only for the Playwright harness build. Never set this in a deployment.
# VITE_LOCAL_HARNESS=1
# VITE_HARNESS_PASSWORD=harness-password

# --- Integration tests only. Do NOT prefix these with VITE_. ---
# The service role bypasses Row Level Security. It must never appear in browser
# assets, .env files committed to git, or any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only when SUPABASE url is a dedicated disposable test project
# (not local). The integration suite refuses remote hosts unless this is set.
# SUPABASE_ALLOW_REMOTE_TEST=

# Synthetic accounts created by tests/integration via the Admin API.
# Use a dedicated test project. Do not point these at real people.
TEST_USER_OWNER_EMAIL=owner.fieldsurvey.test@example.com
TEST_USER_OWNER_PASSWORD=replace-with-a-long-test-password
TEST_USER_ADMIN_EMAIL=admin.fieldsurvey.test@example.com
TEST_USER_ADMIN_PASSWORD=replace-with-a-long-test-password
TEST_USER_RESEARCHER_EMAIL=researcher.fieldsurvey.test@example.com
TEST_USER_RESEARCHER_PASSWORD=replace-with-a-long-test-password
TEST_USER_FIELDWORKER_EMAIL=fieldworker.fieldsurvey.test@example.com
TEST_USER_FIELDWORKER_PASSWORD=replace-with-a-long-test-password
TEST_USER_VIEWER_EMAIL=viewer.fieldsurvey.test@example.com
TEST_USER_VIEWER_PASSWORD=replace-with-a-long-test-password
TEST_USER_OUTSIDER_EMAIL=outsider.fieldsurvey.test@example.com
TEST_USER_OUTSIDER_PASSWORD=replace-with-a-long-test-password
